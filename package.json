{
  "name": "cloud-cost-anomaly",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "rebuild:demo": "cd backend && tsx scripts/rebuildDemoData.ts",
    "experiments": "cd backend && tsx scripts/runExperiments.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
